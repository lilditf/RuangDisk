<Window x:Class="RuangDisk.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RuangDisk.App.ViewModels"
        xmlns:models="clr-namespace:RuangDisk.App.Models"
        mc:Ignorable="d"
        Title="RuangDisk — Penganalisis Ruang Penyimpanan Windows"
        Height="800" Width="1320"
        MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Command & Navigation Bar -->
            <RowDefinition Height="Auto" />
            <!-- Progress & Status Info -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
            <!-- Bottom Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. TOP HEADER & COMMAND TOOLBAR -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand Identity -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <Border Background="{StaticResource PrimaryBrush}" CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0">
                        <TextBlock Text="💾" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="RuangDisk" FontWeight="Bold" FontSize="16" Foreground="White" />
                            <Border Background="#1E3A8A" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="PRO MAX" FontSize="9" FontWeight="Bold" Foreground="#93C5FD" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Analisis Disk Mandiri &amp; 100% Privat" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Target Path & Selector -->
                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CanScan}"
                             FontSize="13"
                             Padding="12,8"
                             VerticalContentAlignment="Center"
                             ToolTip="Ketik atau pilih jalur folder/drive yang akan dipindai" />

                    <Button Grid.Column="1"
                            Style="{StaticResource SecondaryButton}"
                            Content="📁 Pilih Folder..."
                            Click="BrowseFolder_Click"
                            IsEnabled="{Binding CanScan}"
                            Margin="8,0,0,0"
                            Padding="12,8" />
                </Grid>

                <!-- Actions & Commands -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Scan Button -->
                    <Button Content="⚡ Mulai Pindai"
                            Command="{Binding StartScanCommand}"
                            Visibility="{Binding CanScan, Converter={StaticResource BoolToVisConverter}}"
                            Padding="16,8"
                            Margin="0,0,8,0" />

                    <!-- Pause/Resume Button -->
                    <Button Command="{Binding TogglePauseScanCommand}"
                            Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisConverter}}"
                            Padding="12,8"
                            Margin="0,0,8,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Setter Property="Content" Value="⏸ Jeda" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                        <Setter Property="Content" Value="▶ Lanjutkan" />
                                        <Setter Property="Background" Value="#047857" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Cancel Button -->
                    <Button Content="⏹ Batal"
                            Style="{StaticResource DangerButton}"
                            Command="{Binding CancelScanCommand}"
                            Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisConverter}}"
                            Padding="14,8"
                            Margin="0,0,8,0" />

                    <!-- Snapshot Menu -->
                    <Button Content="💾 Snapshot"
                            Style="{StaticResource SecondaryButton}"
                            Click="SnapshotMenu_Click"
                            Margin="0,0,8,0"
                            Padding="12,8" />

                    <!-- Export CSV -->
                    <Button Content="📄 Ekspor CSV"
                            Style="{StaticResource SecondaryButton}"
                            Click="ExportCsv_Click"
                            IsEnabled="{Binding HasResults}"
                            Margin="0,0,8,0"
                            Padding="12,8" />

                    <!-- Rescan Button -->
                    <Button Content="🔄 Pindai Ulang"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding StartScanCommand}"
                            IsEnabled="{Binding CanScan}"
                            Padding="12,8" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. SCAN PROGRESS, SPEED METRICS & BANNER -->
        <StackPanel Grid.Row="1">
            <!-- Stale Results Warning Banner -->
            <Border Background="#78350F" BorderBrush="#B45309" BorderThickness="0,0,0,1" Padding="18,7"
                    Visibility="{Binding IsScanStale, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock Foreground="#FEF3C7" FontWeight="SemiBold" FontSize="12">
                    ⚠️ File telah dipindahkan ke Recycle Bin. Hasil analisis saat ini telah usang. Klik <Run Text="'Pindai Ulang'" FontWeight="Bold" /> untuk menyinkronkan data.
                </TextBlock>
            </Border>

            <!-- Snapshot Loaded Banner -->
            <Border Background="#1E3A8A" BorderBrush="#2563EB" BorderThickness="0,0,0,1" Padding="18,7"
                    Visibility="{Binding IsSnapshotLoaded, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock Foreground="#DBEAFE" FontWeight="SemiBold" FontSize="12">
                    📂 Menampilkan file snapshot tersimpan (Mode Baca Saja). Target asli tidak dipindai secara langsung.
                </TextBlock>
            </Border>

            <!-- Scanning Status Bar with Speed Indicator -->
            <Border Background="#111827" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,6"
                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisConverter}}">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#10B981" CornerRadius="4" Width="8" Height="8" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#E2E8F0" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ScanSpeedFormatted}" Foreground="#38BDF8" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Active Scan Progress Bar -->
            <ProgressBar Height="3"
                         IsIndeterminate="{Binding IsScanning}"
                         Background="#1E293B"
                         Foreground="{StaticResource PrimaryBrush}"
                         BorderThickness="0"
                         Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisConverter}}" />
        </StackPanel>

        <!-- 3. MAIN WORKSPACE (Drives Left, Tabs Center, Inspector Right) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Left Panel: Drives & Targets -->
                <ColumnDefinition Width="280" MinWidth="220" MaxWidth="420" />
                <ColumnDefinition Width="5" />
                <!-- Center Panel: Tabs (Tree, Treemap, Top Files, Types) -->
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="5" />
                <!-- Right Panel: Selection Details & Inspector -->
                <ColumnDefinition Width="330" MinWidth="260" MaxWidth="520" />
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: DRIVES & TARGETS -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="DRIVE PENYIMPANAN" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="4,0,0,10" />

                    <!-- Drives List -->
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding Drives}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0B0F19" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10" Cursor="Hand" MouseLeftButtonDown="DriveCard_Click">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <DockPanel Grid.Row="0">
                                                <TextBlock Text="💽" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White" FontSize="13" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>

                                            <!-- Usage Progress Bar with Color Warning -->
                                            <ProgressBar Grid.Row="1" Height="6" Value="{Binding UsedPercentage, Mode=OneWay}" Maximum="100" Margin="0,10,0,6" Background="#1F2937" Foreground="{StaticResource PrimaryBrush}" BorderThickness="0" />

                                            <DockPanel Grid.Row="2">
                                                <TextBlock Text="{Binding UsedPercentage, StringFormat={}{0:F1}% terpakai}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding FileSystem}" HorizontalAlignment="Right" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Separator Grid.Row="2" Background="{StaticResource BorderBrush}" Margin="0,10" />

                    <!-- Recent Targets -->
                    <StackPanel Grid.Row="3">
                        <TextBlock Text="RIWAYAT TARGET TERAKHIR" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="4,0,0,8" />
                        <ItemsControl ItemsSource="{Binding RecentTargets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0B0F19" CornerRadius="5" Padding="8,5" Margin="0,2" Cursor="Hand" MouseLeftButtonDown="RecentTarget_Click" ToolTip="{Binding}">
                                        <TextBlock Text="{Binding}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Splitter 1 -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- CENTER PANEL: TAB WORKSPACES -->
            <Border Grid.Column="2" Background="{StaticResource BgDarkBrush}" Padding="14">
                <TabControl SelectedIndex="{Binding SelectedTabIndex}">

                    <!-- TAB 1: POHON FOLDER (TREE) -->
                    <TabItem Header="🌲 Pohon Folder">
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Tree Search Filter -->
                            <TextBox Grid.Row="0"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="10,7"
                                     Margin="0,0,0,10"
                                     ToolTip="Cari nama folder atau file dalam hasil pemindaian..." />

                            <!-- Lazy Loading TreeView with Column Headers -->
                            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Table-Like Column Header for Tree -->
                                    <Border Grid.Row="0" Background="#111827" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,6,10,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="280" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Nama" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="Ukuran Logis" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Right" Margin="0,0,12,0" />
                                            <TextBlock Grid.Column="2" Text="Persentase" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Grid.Column="3" Text="Item" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Grid.Column="4" Text="Waktu Modifikasi" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Grid>
                                    </Border>

                                    <!-- TreeView with On-Demand Lazy Loading -->
                                    <TreeView Grid.Row="1"
                                              ItemsSource="{Binding RootTreeItems}"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              VirtualizingStackPanel.IsVirtualizing="True"
                                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                                              SelectedItemChanged="TreeView_SelectedItemChanged">
                                        <TreeView.ItemTemplate>
                                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                                <Border CornerRadius="4" Padding="4,3" Margin="0,1">
                                                    <Border.ContextMenu>
                                                        <ContextMenu Background="{StaticResource SurfaceBrush}" Foreground="White" BorderBrush="{StaticResource BorderBrush}">
                                                            <MenuItem Header="Buka File / Folder" Click="ContextMenu_OpenFile_Click" />
                                                            <MenuItem Header="Tampilkan di Windows Explorer" Click="ContextMenu_Reveal_Click" />
                                                            <MenuItem Header="Salin Path Lengkap" Click="ContextMenu_CopyPath_Click" />
                                                            <Separator Background="{StaticResource BorderBrush}" />
                                                            <MenuItem Header="Pindahkan ke Recycle Bin" Click="ContextMenu_Recycle_Click" Foreground="#EF4444" />
                                                        </ContextMenu>
                                                    </Border.ContextMenu>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="20" />
                                                            <ColumnDefinition Width="260" />
                                                            <ColumnDefinition Width="100" />
                                                            <ColumnDefinition Width="120" />
                                                            <ColumnDefinition Width="80" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Icon -->
                                                        <TextBlock Grid.Column="0" FontSize="12">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="📄" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                                            <Setter Property="Text" Value="📁" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <!-- Name -->
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                                        <!-- Size -->
                                                        <TextBlock Grid.Column="2" Text="{Binding FormattedSize}" Foreground="#38BDF8" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />

                                                        <!-- Percentage Bar -->
                                                        <Grid Grid.Column="3" Margin="0,0,12,0" VerticalAlignment="Center">
                                                            <ProgressBar Height="8" Value="{Binding Percentage, Mode=OneWay}" Maximum="100" Background="#1F2937" Foreground="{StaticResource PrimaryBrush}" BorderThickness="0" />
                                                            <TextBlock Text="{Binding FormattedPercentage}" FontSize="8" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Grid>

                                                        <!-- File/Dir Counts -->
                                                        <TextBlock Grid.Column="4" Text="{Binding FileCount, StringFormat={}{0:N0} file}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />

                                                        <!-- Last Modified -->
                                                        <TextBlock Grid.Column="5" Text="{Binding LastModifiedFormatted}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </HierarchicalDataTemplate>
                                        </TreeView.ItemTemplate>
                                    </TreeView>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- TAB 2: TREEMAP DENGAN BREADCRUMB DRILL-DOWN -->
                    <TabItem Header="🗺 Peta Ruang (Treemap)">
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Treemap Navigation & Breadcrumbs -->
                            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Navigasi: " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ItemsControl ItemsSource="{Binding TreemapBreadcrumbs}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="{Binding Name}"
                                                                Style="{StaticResource SecondaryButton}"
                                                                Click="Breadcrumb_Click"
                                                                Padding="6,3" FontSize="11" Margin="0,0,4,0" />
                                                        <TextBlock Text="›" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,6,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <Button DockPanel.Dock="Right" Content="Segarkan Peta" Style="{StaticResource SecondaryButton}" Click="RefreshTreemap_Click" Padding="10,5" FontSize="11" />
                                </DockPanel>
                            </Border>

                            <!-- Treemap Canvas Host -->
                            <Border Grid.Row="1" Background="#0B0F19" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                <ItemsControl x:Name="TreemapItemsControl" ItemsSource="{Binding TreemapItems}" SizeChanged="TreemapCanvas_SizeChanged">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Background="Transparent" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="{Binding Width}" Height="{Binding Height}"
                                                    Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                    BorderBrush="#0B0F19" BorderThickness="1.5"
                                                    CornerRadius="4" Cursor="Hand"
                                                    MouseLeftButtonDown="TreemapBlock_MouseLeftButtonDown"
                                                    ToolTipService.ShowDuration="12000">
                                                <Border.ToolTip>
                                                    <ToolTip Background="#0B0F19" Foreground="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                        <StackPanel Margin="6">
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="13" Foreground="White" />
                                                            <TextBlock Text="{Binding FullPath}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,6" />
                                                            <TextBlock Text="{Binding FormattedSize, StringFormat=Ukuran: {0}}" FontWeight="SemiBold" Foreground="#38BDF8" />
                                                            <TextBlock Text="{Binding Percentage, StringFormat=Proporsi: {0:F1}%}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                            <TextBlock Text="💡 Klik 2x untuk memperbesar folder (Zoom-in)" FontSize="10" Foreground="#A78BFA" Margin="0,4,0,0" />
                                                        </StackPanel>
                                                    </ToolTip>
                                                </Border.ToolTip>
                                                <Grid Margin="6" ClipToBounds="True">
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="White" FontWeight="Bold" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding FormattedSize}" Foreground="#E2E8F0" FontSize="10" VerticalAlignment="Bottom" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- TAB 3: FILE TERBESAR DENGAN FILTER PRESETS -->
                    <TabItem Header="📊 File Terbesar">
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Quick Filter Pills -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Filter Cepat: " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Button Content="Semua" Style="{StaticResource SecondaryButton}" Click="FilterPill_All_Click" Margin="0,0,6,0" Padding="10,4" FontSize="11" />
                                <Button Content="⚡ > 1 GB" Style="{StaticResource SecondaryButton}" Click="FilterPill_1GB_Click" Margin="0,0,6,0" Padding="10,4" FontSize="11" />
                                <Button Content="📦 > 100 MB" Style="{StaticResource SecondaryButton}" Click="FilterPill_100MB_Click" Margin="0,0,6,0" Padding="10,4" FontSize="11" />
                                <Button Content="🕒 Lama (> 1 Thn)" Style="{StaticResource SecondaryButton}" Click="FilterPill_Old_Click" Margin="0,0,6,0" Padding="10,4" FontSize="11" />
                                <Button Content="🎬 Video &amp; Arsip" Style="{StaticResource SecondaryButton}" Click="FilterPill_Media_Click" Padding="10,4" FontSize="11" />
                            </StackPanel>

                            <!-- DataGrid -->
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding LargestFiles}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      Background="{StaticResource SurfaceBrush}"
                                      BorderBrush="{StaticResource BorderBrush}"
                                      BorderThickness="1"
                                      RowBackground="{StaticResource SurfaceBrush}"
                                      AlternatingRowBackground="#111827"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      GridLinesVisibility="None"
                                      SelectionMode="Single"
                                      SelectionChanged="LargestFiles_SelectionChanged">
                                <DataGrid.ContextMenu>
                                    <ContextMenu Background="{StaticResource SurfaceBrush}" Foreground="White" BorderBrush="{StaticResource BorderBrush}">
                                        <MenuItem Header="Buka File" Click="ContextMenu_OpenFile_Click" />
                                        <MenuItem Header="Tampilkan di Windows Explorer" Click="ContextMenu_Reveal_Click" />
                                        <MenuItem Header="Salin Path Lengkap" Click="ContextMenu_CopyPath_Click" />
                                        <Separator Background="{StaticResource BorderBrush}" />
                                        <MenuItem Header="Pindahkan ke Recycle Bin" Click="ContextMenu_Recycle_Click" Foreground="#EF4444" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="40" />
                                    <DataGridTextColumn Header="Nama File" Binding="{Binding Name}" Width="250" />
                                    <DataGridTextColumn Header="Ukuran" Binding="{Binding FormattedSize}" Width="110" />
                                    <DataGridTextColumn Header="Ekstensi" Binding="{Binding Extension}" Width="90" />
                                    <DataGridTextColumn Header="Tanggal Modifikasi" Binding="{Binding LastModifiedFormatted}" Width="150" />
                                    <DataGridTextColumn Header="Lokasi / Jalur" Binding="{Binding FullPath}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- TAB 4: KOMPOSISI JENIS FILE -->
                    <TabItem Header="🏷 Komposisi Jenis File">
                        <Grid Margin="0,10,0,0">
                            <DataGrid ItemsSource="{Binding FileTypes}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      Background="{StaticResource SurfaceBrush}"
                                      BorderBrush="{StaticResource BorderBrush}"
                                      BorderThickness="1"
                                      RowBackground="{StaticResource SurfaceBrush}"
                                      AlternatingRowBackground="#111827"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      GridLinesVisibility="None">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Ekstensi" Binding="{Binding Extension}" Width="140" FontWeight="Bold" />
                                    <DataGridTextColumn Header="Jumlah File" Binding="{Binding FileCount, StringFormat={}{0:N0}}" Width="130" />
                                    <DataGridTextColumn Header="Total Ukuran" Binding="{Binding FormattedSize}" Width="150" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="Persentase" Binding="{Binding FormattedPercentage}" Width="110" />
                                    <DataGridTemplateColumn Header="Distribusi Visual" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ProgressBar Height="8" Value="{Binding Percentage, Mode=OneWay}" Maximum="100"
                                                             Foreground="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                             Background="#1F2937" BorderThickness="0" VerticalAlignment="Center" Margin="6,0" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                </TabControl>
            </Border>

            <!-- Splitter 2 -->
            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- RIGHT PANEL: INSPECTOR & FILE ACTIONS -->
            <Border Grid.Column="4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Padding="16">
                <ScrollViewer>
                    <StackPanel>
                        <!-- Title -->
                        <TextBlock Text="INSPECTOR ITEM" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" />

                        <!-- Empty state -->
                        <Border Background="#0B0F19" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16"
                                Visibility="{Binding SelectedNode, Converter={StaticResource NullToVisConverter}, ConverterParameter=invert}">
                            <TextBlock Text="Pilih folder atau file untuk memeriksa detail metrik dan aksi pembersihan." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="12" TextAlignment="Center" />
                        </Border>

                        <!-- Selected Item Details -->
                        <StackPanel Visibility="{Binding SelectedNode, Converter={StaticResource NullToVisConverter}}">
                            <Border Background="#0B0F19" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedNode.Name}" FontWeight="Bold" FontSize="15" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,6" />

                                    <TextBlock Text="Path Lengkap:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding SelectedNode.FullPath}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />

                                    <Grid Margin="0,4">
                                        <TextBlock Text="Ukuran Logis:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding SelectedNode.LogicalSize, StringFormat={}{0:N0} bytes}" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right" />
                                    </Grid>

                                    <Grid Margin="0,4">
                                        <TextBlock Text="Ukuran Teralokasi:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding SelectedNode.AllocatedSize, StringFormat={}{0:N0} bytes}" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Right" />
                                    </Grid>

                                    <Grid Margin="0,4">
                                        <TextBlock Text="Tipe:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="White">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="File Dokumen" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedNode.IsDirectory}" Value="True">
                                                            <Setter Property="Text" Value="Direktori Folder" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <Grid Margin="0,4">
                                        <TextBlock Text="Total File:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding SelectedNode.FileCount, StringFormat={}{0:N0}}" HorizontalAlignment="Right" Foreground="White" />
                                    </Grid>

                                    <Grid Margin="0,4">
                                        <TextBlock Text="Total Subfolder:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding SelectedNode.DirectoryCount, StringFormat={}{0:N0}}" HorizontalAlignment="Right" Foreground="White" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Copy Feedback Pill -->
                            <Border Background="#065F46" CornerRadius="6" Padding="10,6" Margin="0,0,0,10"
                                    Visibility="{Binding CopyFeedbackVisible, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="✓ Path berhasil disalin ke clipboard!" Foreground="#A7F3D0" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </Border>

                            <!-- Actions -->
                            <TextBlock Text="AKSI FILE AMAN" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />

                            <Button Content="↗ Buka File / Folder" Style="{StaticResource SecondaryButton}" Command="{Binding OpenFileCommand}" Margin="0,0,0,6" HorizontalContentAlignment="Left" />
                            <Button Content="📂 Tampilkan di Explorer" Style="{StaticResource SecondaryButton}" Command="{Binding RevealInExplorerCommand}" Margin="0,0,0,6" HorizontalContentAlignment="Left" />
                            <Button Content="📋 Salin Path Lengkap" Style="{StaticResource SecondaryButton}" Command="{Binding CopyPathCommand}" Margin="0,0,0,14" HorizontalContentAlignment="Left" />

                            <!-- Safe Delete (Recycle Bin Only) -->
                            <Button Content="🗑 Pindahkan ke Recycle Bin" Style="{StaticResource DangerButton}" Command="{Binding MoveToRecycleBinCommand}" HorizontalContentAlignment="Left" Margin="0,0,0,16" />
                        </StackPanel>

                        <!-- Errors Summary (If Any) -->
                        <Border Background="#450A0A" BorderBrush="#991B1B" BorderThickness="1" CornerRadius="8" Padding="12"
                                Visibility="{Binding Errors.Count, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel>
                                <TextBlock Text="RINGKASAN ERROR SCAN" FontWeight="Bold" FontSize="11" Foreground="#FCA5A5" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding Errors.Count, StringFormat={}{0} error terlokalisasi tanpa menghentikan scan:}" FontSize="11" Foreground="#FECACA" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding Errors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#7F1D1D" BorderThickness="0,0,0,1" Padding="0,4">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding ErrorCode}" FontWeight="Bold" FontSize="10" Foreground="#F87171" />
                                                    <TextBlock Text="{Binding SafeMessage}" FontSize="10" Foreground="#E2E8F0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 4. BOTTOM STATUS BAR -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,8">
            <DockPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="Privasi: 100% Offline Lokal" Foreground="#10B981" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <TextBlock Text="v2.0-PRO" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
